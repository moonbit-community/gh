///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/json",
}

///|
async fn main {
  for
    family in [
      "run-rerun", "cache-delete", "run-watch", "run-watch-edge", "workflow-manage",
    ] {
    let data = @json.parse(
      @fs.read_file("testdata/" + family + "-oracle-v2.102.0.json").text(),
    )
    guard data
      is {
        "oracle_sha256": String(
          "8a4258433c81106343144857750316241759d06dcf16265cf3c4864a8f2f2ad6"
        ),
        "failures": Number(0, ..),
        "expected_cases": Number(expected, ..),
        "completed_cases": Number(completed, ..),
        "cases": Array(cases),
        ..
      } &&
      expected == completed &&
      completed == cases.length().to_double() else {
      fail("incomplete oracle")
    }
    let source = StringBuilder()
    source.write_string(
      "// Generated by scripts/run_rerun_tests.mbtx from the fixed oracle.\n",
    )
    for case in cases {
      guard case is { "id": String(id), .. } else { fail("case id") }
      source.write_string(
        "///|\nasync test " +
        Json(family + " oracle " + id).stringify() +
        " {\n",
      )
      source.write_string(
        "  check_actions_mutation_oracle(" +
        Json(case.stringify()).stringify() +
        ")\n}\n",
      )
    }
    @fs.write_file(
      "native/" +
      family.replace_all(old="-", new="_") +
      "_oracle_cases_test.mbt",
      source.to_string(),
    )
  }
}
