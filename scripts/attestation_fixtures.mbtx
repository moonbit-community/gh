///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail(
      "usage: attestation_fixtures.mbtx UPSTREAM_CLI_SOURCE TRUST_CAPTURE_DIRECTORY",
    )
  }
  let upstream = args[1]
  let capture = args[2]
  let destination = "testdata/attestation"
  @fs.mkdir(destination, recursive=true, allow_exist=true)
  let inputs : Array[(String, String)] = [
    (
      "bootstrap-root.json",
      upstream +
      "/pkg/cmd/attestation/verification/embed/tuf-repo.github.com/root.json",
    ),
    (
      "github-release-bundle.json",
      upstream + "/pkg/cmd/attestation/test/data/github_release_bundle.json",
    ),
    (
      "github-release-artifact.zip",
      upstream + "/pkg/cmd/attestation/test/data/github_release_artifact.zip",
    ),
    ("LICENSE", upstream + "/LICENSE"),
  ]
  let manifest = @json.parse(@fs.read_file(capture + "/capture.json").text())
  guard manifest is { "files": Array(files), .. } else {
    fail("capture manifest")
  }
  for entry in files {
    guard entry is { "file": String(name), "sha256": String(hash), .. } else {
      fail("capture entry")
    }
    let bytes = @fs.read_file(capture + "/" + name).binary()
    guard @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) == hash else {
      fail("capture hash drift")
    }
    inputs.push((name, capture + "/" + name))
  }
  let records : Array[Json] = []
  let generated = StringBuilder()
  let native_fixture = StringBuilder()
  native_fixture.write_string(
    "// Generated public trust fixtures for native transport/cache tests.\n///|\nfn native_trust_fixture(name : String) -> Bytes {\n  match name {\n",
  )
  generated.write_string(
    "// Generated by scripts/attestation_fixtures.mbtx; public upstream fixtures only.\n",
  )
  generated.write_string(
    "///|\nfn trust_fixture(name : String) -> Bytes {\n  match name {\n",
  )
  for (name, source) in inputs {
    let bytes = @fs.read_file(source).binary()
    @fs.write_file(destination + "/" + name, bytes)
    records.push({
      "file": name,
      "sha256": @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
    })
    if name.has_suffix(".json") {
      generated.write_string(
        "    " +
        Json(name).stringify() +
        " => @utf8.encode(" +
        Json(@utf8.decode(bytes)).stringify() +
        ")\n",
      )
      native_fixture.write_string(
        "    " +
        Json(name).stringify() +
        " => @utf8.encode(" +
        Json(@utf8.decode(bytes)).stringify() +
        ")\n",
      )
    }
  }
  generated.write_string(
    "    _ => abort(\"unknown public trust fixture\")\n  }\n}\n",
  )
  @fs.write_file(
    "internal/attestation/fixtures_wbtest.mbt",
    generated.to_string(),
  )
  native_fixture.write_string(
    "    _ => abort(\"unknown public trust fixture\")\n  }\n}\n",
  )
  @fs.write_file(
    "native/attestation_fixtures_wbtest.mbt",
    native_fixture.to_string(),
  )
  @fs.write_file(
    "internal/attestation/bootstrap.mbt",
    "// Public trust bootstrap from GitHub CLI v2.102.0 (MIT); see testdata/attestation/provenance.json.\n" +
    "// Generated by scripts/attestation_fixtures.mbtx. Remote roots require cross-signature verification.\n" +
    "///|\npub fn github_tuf_bootstrap() -> Bytes {\n  @utf8.encode(" +
    Json(@fs.read_file(destination + "/bootstrap-root.json").text()).stringify() +
    ")\n}\n",
  )
  @fs.write_file(
    destination + "/provenance.json",
    Json::object({
      "upstream": "https://github.com/cli/cli/tree/v2.102.0/pkg/cmd/attestation",
      "license": "MIT",
      "capture": manifest,
      "files": records,
      "note": "Network capture is not trust. Tests verify the complete root rotation and metadata signatures.",
    }).stringify(indent=2) +
    "\n",
  )
}
