    { name: "actions-run-exit-status", args: [], },
    { name: "cache-safe-skip", args: [], },
  ]
}

///|
async fn self_test() -> Unit {
  let first = unique_marker()
  let second = unique_marker()
  assert_true(first != second)
  assert_true(first.has_prefix("codex-write-"))
  assert_true(
    sanitized_diagnostic(
      { exit_code: 1, stdout: "", stderr: "token-xyz", },
      "token-xyz",
    ) ==
    "<redacted>",
  )
  assert_true(
    !sanitized_diagnostic({ exit_code: 0, stdout: "", stderr: "", }, "token").contains(
      "token",
    ),
  )
  let names = step_plan(first).map(step => step.name)
  for
    name in [
      "issue-create", "issue-delete", "branch-create", "branch-create-base", "pr-create",
      "pr-review-comment", "pr-view-edited", "pr-view-closed", "pr-view-reopened",
      "pr-merge", "pr-view-merged", "branch-view-merged", "contents-view-merged",
      "branch-default-unchanged", "secret-list-deleted", "variable-list-deleted",
      "release-create", "release-download", "release-view-asset-deleted", "release-delete",
      "repo-description-read", "repo-description-edit", "secret-set", "variable-set",
      "variable-read-created", "variable-update", "variable-read-updated", "actions-workflow-list",
      "actions-run-list", "actions-cache-list", "actions-workflow-dispatch", "actions-run-view",
      "actions-run-exit-status", "cache-safe-skip",
    ] {
    assert_true(names.contains(name))
  }
  assert_true(step_plan(first).length() >= 20)
  let secret = fixture_resource_name(first, "SECRET")
  assert_true(secret.has_prefix("CODEX_WRITE_"))
  assert_true(!secret.contains("-"))
  assert_true(
    safe_skip("cache-safe-skip", "fixture")
    .stringify()
    .contains("safe_skip:fixture"),
  )
  assert_true(
    json_array_contains_string(
      "[{\"name\":\"CODEX_WRITE_SECRET\"}]", "name", "CODEX_WRITE_SECRET",
    ),
  )
  let (sensitive_record, sensitive_ok) = step_record_sensitive(
    "secret-fixture",
    { exit_code: 1, stdout: "", stderr: "fixture-secret", },
    "fixture-token",
    "fixture-secret",
  )
  assert_false(sensitive_ok)
  let sensitive_text = sensitive_record.stringify()
  assert_true(sensitive_text.contains("secret_in_output"))
  assert_false(sensitive_text.contains("fixture-secret"))
  // Endpoint requirements do not describe the caller's token grants. A read
  // response header must never turn a later real write result into a skip.
  let (_, read_probe_ok) = step_record(
    "variable-read-probe",
    {
      exit_code: 0,
      stdout: "X-Accepted-GitHub-Permissions: actions_variables=read\n",
      stderr: "",
    },
    "fixture-token",
  )
  assert_true(read_probe_ok)
  let (write_record, write_ok) = step_record_sensitive(
    "variable-set",
    { exit_code: 0, stdout: "", stderr: "", },
    "fixture-token",
    "fixture-value",
  )
  assert_true(write_ok)
  assert_false(write_record.stringify().contains("skipped"))
  let (failed_record, failed_ok) = step_record_sensitive(
    "variable-set",
    { exit_code: 1, stdout: "", stderr: "HTTP 404", },
    "fixture-token",
    "fixture-value",
  )
  assert_false(failed_ok)
  assert_false(failed_record.stringify().contains("skipped"))
  let (readback_record, readback_ok) = variable_readback_record(
    "variable-read-created",
    {
      exit_code: 0,
      stdout: "{\"name\":\"FIXTURE_VARIABLE\",\"value\":\"fixture-value\"}",
      stderr: "",
    },
    "fixture-token",
    "FIXTURE_VARIABLE",
    "fixture-value",
  )
  assert_true(readback_ok)
  assert_false(readback_record.stringify().contains("fixture-value"))
  let (mismatch_record, mismatch_ok) = variable_readback_record(
    "variable-read-updated",
    {
      exit_code: 0,
      stdout: "{\"name\":\"FIXTURE_VARIABLE\",\"value\":\"old-value\"}",
      stderr: "",
    },
    "fixture-token",
    "FIXTURE_VARIABLE",
    "fixture-value",
  )
  assert_false(mismatch_ok)
  assert_false(mismatch_record.stringify().contains("old-value"))
  let (_, leaked_readback_ok) = variable_readback_record(
    "variable-read-created",
    { exit_code: 1, stdout: "", stderr: "fixture-value fixture-token", },
    "fixture-token",
    "FIXTURE_VARIABLE",
    "fixture-value",
  )
  assert_false(leaked_readback_ok)
  assert_true(json_name_absent("[]", "FIXTURE"))
  assert_true(json_name_absent("[{\"name\":\"OTHER\"}]", "FIXTURE"))
  assert_false(json_name_absent("[{\"name\":\"FIXTURE\"}]", "FIXTURE"))
  assert_false(json_name_absent("[{}]", "FIXTURE"))
  assert_false(json_name_absent("not JSON", "FIXTURE"))
  assert_true(json_true("{\"merged\":true}", "merged"))
  assert_false(json_true("{\"merged\":false}", "merged"))
  assert_false(json_true("{\"merged\":\"true\"}", "merged"))
  assert_true(
    release_asset_id(
      "{\"assets\":[{\"id\":1,\"name\":\"other.asset\"},{\"id\":2,\"name\":\"marker.asset\"}]}",
      "marker.asset",
    )
    is Ok(Some("2")),
  )
  assert_true(release_asset_id("{\"assets\":[]}", "marker.asset") is Ok(None))
  assert_true(release_asset_id("{}", "marker.asset") is Err(_))
  assert_true(release_asset_id("not JSON", "marker.asset") is Err(_))
  let (mismatch, matched) = assertion_record(
    "fixture-check",
    { exit_code: 0, stdout: "private body", stderr: "", },
    "fixture-token",
    false,
    "fixture_mismatch",
  )
  assert_false(matched)
  assert_false(mismatch.stringify().contains("private body"))
  let files = @fs.tmpdir(prefix="gh-fixture-self-test-")
  defer @fs.rmdir(files, recursive=true)
  @fs.write_file(files + "/original", b"fixture\x00bytes", permission=0o600)
  @fs.write_file(files + "/downloaded", b"fixture\x00bytes", permission=0o600)
  assert_true(fixture_files_equal(files + "/original", files + "/downloaded"))
  @fs.write_file(files + "/downloaded", b"fixture\x00other", permission=0o600)
  assert_false(fixture_files_equal(files + "/original", files + "/downloaded"))
  assert_false(fixture_files_equal(files + "/original", files + "/missing"))
  println("live write fixture self-test passed (no network)")
}

///|
fn api_path(path : String) -> Array[String] {
  ["api", path, "--hostname", "github.com"]
}

///|
async fn verify_oracle(
  path : String,
  binary : String,
  config : String,
  token : String,
) -> Unit {
  let oracle = @fs.realpath(path)
  guard oracle != binary &&
    @fs.kind(oracle) is @fs.Regular &&
    @fs.can_execute(oracle) else {
    fail("oracle must be a separate executable regular file")
  }
  guard @env.get_env_var("GH_ORACLE_SHA256") is Some(expected) &&
    @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(oracle).binary())) ==
    expected else {
    fail("GH_ORACLE_SHA256 is missing or mismatched")
  }
  let version = @shell.Cmd(
    oracle,
    ["--version"],
    cwd=config,
    inherit_env=false,
    env=isolated_environment(config, token),
  ).output(timeout_ms=10000, max_output_bytes=65536)
  guard version.exit_code() == 0 &&
    (
      version.stdout().has_prefix("gh version 2.102.0\n") ||
      version.stdout().has_prefix("gh version 2.102.0 (")
    ) else {
    fail("oracle must be gh v2.102.0")
  }
}

///|
fn base64_encode(value : String) -> String {
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let bytes = value.to_array()
  let output = StringBuilder()
  let mut index = 0
  while index < bytes.length() {
    let a = bytes[index].to_int()
    let b = if index + 1 < bytes.length() {
      bytes[index + 1].to_int()
    } else {
      0
    }
    let c = if index + 2 < bytes.length() {
      bytes[index + 2].to_int()
    } else {
      0
    }
    output.write_char(alphabet.get_char(a >> 2).unwrap())
    output.write_char(alphabet.get_char(((a & 3) << 4) | (b >> 4)).unwrap())
    if index + 1 < bytes.length() {
      output.write_char(alphabet.get_char(((b & 15) << 2) | (c >> 6)).unwrap())
    } else {
      output.write_char('=')
    }
    if index + 2 < bytes.length() {
      output.write_char(alphabet.get_char(c & 63).unwrap())
    } else {
      output.write_char('=')
    }
    index += 3
  }
  output.to_string()
}

///|
fn nested_string(value : String, parent : String, key : String) -> String? {
  let parsed : Json = @json.parse(value) catch { _ => return None }
  match parsed {
    Object(fields) =>
      match fields.get(parent) {
        Some(Object(child)) =>
          match child.get(key) {
            Some(String(text)) => Some(text)
            _ => None
          }
        _ => None
      }
    _ => None
  }
}

///|
fn release_asset_id(value : String, name : String) -> Result[String?, Unit] {
  let parsed : Json = @json.parse(value) catch { _ => return Err(()) }
  match parsed {
    Object(fields) =>
      match fields.get("assets") {
        Some(Array(items)) => {
          for item in items {
            match item {
              Object(asset) if asset.get("name") == Some(Json(name)) =>
                match asset.get("id") {
                  Some(Number(id, ..)) =>
                    return Ok(Some(id.to_int().to_string()))
                  Some(String(id)) if !id.is_empty() => return Ok(Some(id))
                  _ => return Err(())
                }
              _ => ()
            }
          }
          Ok(None)
        }
        _ => Err(())
      }
    _ => Err(())
  }
}

///|
async fn main {
  let argv = @env.args()
  if argv.length() == 2 && argv[1] == "--self-test" {
    self_test()
    return
  }
  guard argv.length() <= 3 else {
    fail(
      "usage: live_github_write_fixture.mbtx [PROJECT_BINARY [REPORT_PATH]] | --self-test",
    )
  }
  guard @env.get_env_var("LIVE_GITHUB") == Some("1") else {
    fail("live writes require LIVE_GITHUB=1")
  }
  guard @env.get_env_var("GH_LIVE_REPO") == Some(allowed_repo) else {
    fail("GH_LIVE_REPO must be ZSeanYves/gh_test")
  }
  let token = match @env.get_env_var("GH_TOKEN") {
    Some(value) if !value.is_empty() => value
    _ => fail("set GH_TOKEN locally; do not put it in arguments")
  }
  guard @env.get_env_var("GH_HOST").unwrap_or("github.com") == "github.com" else {
    fail("this runner permits github.com only")
  }
  let root = @fs.realpath(@env.current_dir().unwrap_or("."))
  let binary = @fs.realpath(
    argv.get(1).unwrap_or(root + "/_build/native/debug/build/cmd/main/main.exe"),
  )
  guard @fs.kind(binary) is @fs.Regular && @fs.can_execute(binary) else {
    fail("project binary must be an executable regular file")
  }
  let marker = unique_marker()
  let report_path = argv
    .get(2)
    .unwrap_or(root + "/_build/live-github-write-" + marker + ".json")
  guard !@fs.exists(report_path) else {
    fail("report already exists; supply a new report path")
  }
  let config = @fs.tmpdir(prefix="gh-live-write-")
  defer @fs.rmdir(config, recursive=true)
  @fs.chmod(config, 0o700)
  if @env.get_env_var("GH_ORACLE_BINARY") is Some(path) {
    verify_oracle(path, binary, config, token)
  }
  let reports : Array[Json] = []
  let mut all_passed = true
  let residual : Array[String] = []
  let mut issue_number : String? = None
  let mut branch : String? = None
  let mut merge_base_branch : String? = None
  let mut pr_number : String? = None
  let mut pr_merged = false
  let mut release_tag : String? = None
  let mut release_deleted = false
  let mut release_tag_deleted = false
  let mut asset_id : String? = None
  let mut file_path : String? = None
  let mut file_sha : String? = None
  let mut pr_head_sha : String? = None
  let secret_name = fixture_resource_name(marker, "SECRET")
  let variable_name = fixture_resource_name(marker, "VARIABLE")
  let variable_value = marker + " variable value"
  let variable_updated_value = variable_value + " updated"
  let mut secret_created = false
  let mut variable_created = false

  // Issue create and its state lifecycle.
  let create = run_command(binary, config, token, step_plan(marker)[0].args)
  let (entry, passed) = step_record("issue-create", create, token)
  reports.push(entry)
  all_passed = all_passed && passed
  if passed {
    issue_number = resource_number(create)
  }
  if issue_number is None {
    all_passed = false
  }
  match issue_number {
    Some(number) => {
      let view = run_command(binary, config, token, [
        "issue", "view", number, "-R", allowed_repo, "--json", "number,title,state",
      ])
      let (e, ok) = state_step(
        "issue-view-created", view, token, "open", marker,
      )
      reports.push(e)
      all_passed = all_passed && ok
      let comment = run_command(binary, config, token, [
        "issue",
        "comment",
        number,
        "-R",
        allowed_repo,
        "--body",
        marker + " comment",
      ])
      let (e, ok) = step_record("issue-comment", comment, token)
      reports.push(e)
      all_passed = all_passed && ok
      let edit = run_command(binary, config, token, [
        "issue",
        "edit",
        number,
        "-R",
        allowed_repo,
        "--title",
        marker + " edited",
        "--body",
        marker + " edited body",
      ])
      let (e, ok) = step_record("issue-edit", edit, token)
      reports.push(e)
      all_passed = all_passed && ok
      let close = run_command(binary, config, token, [
        "issue", "close", number, "-R", allowed_repo, "--reason", "completed",
      ])
      let (e, ok) = step_record("issue-close", close, token)
      reports.push(e)
      all_passed = all_passed && ok
      let closed = run_command(binary, config, token, [
        "issue", "view", number, "-R", allowed_repo, "--json", "number,title,state",
      ])
      let (e, ok) = state_step(
        "issue-view-closed",
        closed,
        token,
        "closed",
        marker + " edited",
      )
      reports.push(e)
      all_passed = all_passed && ok
      let reopen = run_command(binary, config, token, [
        "issue", "reopen", number, "-R", allowed_repo,
      ])
      let (e, ok) = step_record("issue-reopen", reopen, token)
      reports.push(e)
      all_passed = all_passed && ok
      let opened = run_command(binary, config, token, [
        "issue", "view", number, "-R", allowed_repo, "--json", "number,title,state",
      ])
      let (e, ok) = state_step(
        "issue-view-reopened",
        opened,
        token,
        "open",
        marker + " edited",
      )
      reports.push(e)
      all_passed = all_passed && ok
      let lock = run_command(binary, config, token, [
        "issue", "lock", number, "-R", allowed_repo, "--reason", "resolved",
      ])
      let (e, ok) = step_record("issue-lock", lock, token)
      reports.push(e)
      all_passed = all_passed && ok
      let unlock = run_command(binary, config, token, [
        "issue", "unlock", number, "-R", allowed_repo,
      ])
      let (e, ok) = step_record("issue-unlock", unlock, token)
      reports.push(e)
      all_passed = all_passed && ok
      let delete = run_command(binary, config, token, [
        "issue", "delete", number, "-R", allowed_repo, "--yes",
      ])
      let (e, ok) = step_record("issue-delete", delete, token)
      reports.push(e)
      all_passed = all_passed && ok
      if ok {
        issue_number = None
      }
    }
    None => ()
  }

  // The remaining resources use raw API calls where the command can expose
  // generated IDs. They are best-effort so a private repository without a
  // default branch, Actions, or release permission still gets clean rollback.
  let repo = run_command(
    binary,
    config,
    token,
    api_path("/repos/" + allowed_repo),
  )
  let base = json_string(repo.stdout, "default_branch").unwrap_or("main")

  // Repository edit is reversible only when the original description was
  // read successfully.  Refuse to guess an absent/null value: a read-only
  // token or an unexpected response becomes a visible safe skip rather than
  // risking an overwrite of existing repository metadata.
  let repo_view = run_command(binary, config, token, [
    "repo", "view", "-R", allowed_repo, "--json", "description",
  ])
  let (repo_read_entry, repo_read_ok) = step_record(
    "repo-description-read", repo_view, token,
  )
  reports.push(repo_read_entry)
  all_passed = all_passed && repo_read_ok
  match (repo_read_ok, json_string(repo_view.stdout, "description")) {
    (true, Some(original_description)) => {
      let edit = run_command(binary, config, token, [
        "repo",
        "edit",
        "-R",
        allowed_repo,
        "--description",
        marker + " repository description",
      ])
      let (e, ok) = step_record("repo-description-edit", edit, token)
      reports.push(e)
      all_passed = all_passed && ok

      let edited_view = run_command(binary, config, token, [
        "repo", "view", "-R", allowed_repo, "--json", "description",
      ])
      let (view_entry, view_ok) = step_record(
        "repo-description-view-edited", edited_view, token,
      )
      let view_ok = view_ok &&
        json_string(edited_view.stdout, "description") ==
        Some(marker + " repository description")
      reports.push(
        if view_ok {
          view_entry
        } else {
          {
            "name": Json("repo-description-view-edited"),
            "exit_code": Json(edited_view.exit_code),
            "passed": Json(false),
            "diagnostic": Json("description_mismatch_after_edit"),
          }
        },
      )
      all_passed = all_passed && view_ok

      // Restore even if verification failed, because the edit command may
      // have succeeded while returning an unexpected representation.
      let restore = run_command(binary, config, token, [
        "repo", "edit", "-R", allowed_repo, "--description", original_description,
      ])
      let (restore_entry, restore_ok) = step_record(
        "repo-description-restore", restore, token,
      )
      reports.push(restore_entry)
      all_passed = all_passed && restore_ok
      if !restore_ok {
        residual.push("repository:description")
      }
      let restored_view = run_command(binary, config, token, [
        "repo", "view", "-R", allowed_repo, "--json", "description",
      ])
      let (restored_entry, restored_command_ok) = step_record(
        "repo-description-view-restored", restored_view, token,
      )
      let restored_ok = restored_command_ok &&
        json_string(restored_view.stdout, "description") ==
        Some(original_description)
      reports.push(
        if restored_ok {
          restored_entry
        } else {
          {
            "name": Json("repo-description-view-restored"),
            "exit_code": Json(restored_view.exit_code),
            "passed": Json(false),
            "diagnostic": Json("description_mismatch_after_restore"),
          }
        },
      )
      all_passed = all_passed && restored_ok
      if !restored_ok && !residual.contains("repository:description") {
        residual.push("repository:description")
      }
    }
    (true, None) =>
      reports.push(
        safe_skip("repo-description-edit", "description_is_null_or_missing"),
      )
    (false, _) => {
      reports.push(
        safe_skip("repo-description-edit", "description_read_failed"),
      )
      reports.push(
        safe_skip("repo-description-restore", "description_read_failed"),
      )
    }
  }

  // Secret values are marker-scoped and are never requested back from the
  // API.  Listing checks only the name, and deletion is attempted whenever a
  // set operation succeeded so a later assertion cannot strand the secret.
  let secret_set = run_command(binary, config, token, [
    "secret",
    "set",
    secret_name,
    "-R",
    allowed_repo,
    "--body",
    marker + " secret value",
  ])
  let (e, ok) = step_record_sensitive(
    "secret-set",
    secret_set,
    token,
    marker + " secret value",
  )
  reports.push(e)
  all_passed = all_passed && ok
  if secret_set.exit_code == 0 {
    secret_created = true
  }
  if secret_created {
    let secret_list = run_command(binary, config, token, [
      "secret", "list", "-R", allowed_repo, "--json", "name",
    ])
    let (base_entry, command_ok) = step_record_sensitive(
      "secret-list",
      secret_list,
      token,
      marker + " secret value",
    )
    let list_ok = command_ok &&
      json_array_contains_string(secret_list.stdout, "name", secret_name)
    reports.push(
      if list_ok {
        base_entry
      } else {
        {
          "name": Json("secret-list"),
          "exit_code": Json(secret_list.exit_code),
          "passed": Json(false),
          "diagnostic": Json("secret_name_missing_from_list"),
        }
      },
    )
    all_passed = all_passed && list_ok
    let secret_delete = run_command(binary, config, token, [
      "secret", "delete", secret_name, "-R", allowed_repo, "--yes",
    ])
    let (delete_entry, delete_ok) = step_record_sensitive(
      "secret-delete",
      secret_delete,
      token,
      marker + " secret value",
    )
    reports.push(delete_entry)
    all_passed = all_passed && delete_ok
    if secret_delete.exit_code == 0 {
      secret_created = false
    }
    let after_delete = run_command(binary, config, token, [
      "secret", "list", "-R", allowed_repo, "--json", "name",
    ])
    let (e, ok) = name_absence_record(
      "secret-list-deleted",
      after_delete,
      token,
      secret_name,
      marker + " secret value",
    )
    reports.push(e)
    all_passed = all_passed && ok
    if after_delete.exit_code == 0 {
      if json_name_absent(after_delete.stdout, secret_name) {
        secret_created = false
      } else if json_array_contains_string(
          after_delete.stdout,
          "name",
          secret_name,
        ) {
        secret_created = true
      }
    }
  } else {
    reports.push(safe_skip("secret-list", "secret_set_failed"))
    reports.push(safe_skip("secret-delete", "secret_set_failed"))
    reports.push(safe_skip("secret-list-deleted", "secret_set_failed"))
  }

  // Verify actual create and update behavior. X-Accepted-GitHub-Permissions
  // describes an endpoint's requirements, not the token's granted access.
  // Readback compares values in memory; reports never contain those values.
  let variable_set = run_command(binary, config, token, [
    "variable", "set", variable_name, "-R", allowed_repo, "--body", variable_value,
  ])
  // A successful write needs cleanup even when an output-safety assertion
  // fails. Never tie resource ownership to the report's `passed` field.
  if variable_set.exit_code == 0 {
    variable_created = true
  }
  let (e, ok) = step_record_sensitive(
    "variable-set", variable_set, token, variable_value,
  )
  reports.push(e)
  all_passed = all_passed && ok
  if variable_created {
    let variable_read_created = run_command(
      binary,
      config,
      token,
      api_path("/repos/" + allowed_repo + "/actions/variables/" + variable_name),
    )
    let (entry, read_ok) = variable_readback_record(
      "variable-read-created", variable_read_created, token, variable_name, variable_value,
    )
    reports.push(entry)
    all_passed = all_passed && read_ok
    let variable_update = run_command(binary, config, token, [
      "variable", "set", variable_name, "-R", allowed_repo, "--body", variable_updated_value,
    ])
    let (entry, update_ok) = step_record_sensitive(
      "variable-update", variable_update, token, variable_value,
    )
    reports.push(entry)
    all_passed = all_passed && update_ok
    let variable_read_updated = run_command(
      binary,
      config,
      token,
      api_path("/repos/" + allowed_repo + "/actions/variables/" + variable_name),
    )
    let (entry, read_ok) = variable_readback_record(
      "variable-read-updated", variable_read_updated, token, variable_name, variable_updated_value,
    )
    reports.push(entry)
    all_passed = all_passed && read_ok
    let variable_list = run_command(binary, config, token, [
      "variable", "list", "-R", allowed_repo, "--json", "name",
    ])
    let (base_entry, command_ok) = step_record_sensitive(
      "variable-list", variable_list, token, variable_value,
    )
    let list_ok = command_ok &&
      json_array_contains_string(variable_list.stdout, "name", variable_name)
    reports.push(
      if list_ok {
        base_entry
      } else {
        {
          "name": Json("variable-list"),
          "exit_code": Json(variable_list.exit_code),
          "passed": Json(false),
          "diagnostic": Json("variable_name_missing_from_list"),
        }
      },
    )
    all_passed = all_passed && list_ok
    let variable_delete = run_command(binary, config, token, [
      "variable", "delete", variable_name, "-R", allowed_repo, "--yes",
    ])
    let (delete_entry, delete_ok) = step_record_sensitive(
      "variable-delete", variable_delete, token, variable_value,
    )
    reports.push(delete_entry)
    all_passed = all_passed && delete_ok
    if variable_delete.exit_code == 0 {
      variable_created = false
    }
    let after_delete = run_command(binary, config, token, [
      "variable", "list", "-R", allowed_repo, "--json", "name",
    ])
    let (e, ok) = name_absence_record(
      "variable-list-deleted", after_delete, token, variable_name, variable_value,
    )
    reports.push(e)
    all_passed = all_passed && ok
    if after_delete.exit_code == 0 {
      if json_name_absent(after_delete.stdout, variable_name) {
        variable_created = false
      } else if json_array_contains_string(
          after_delete.stdout,
          "name",
          variable_name,
        ) {
        variable_created = true
      }
    }
  } else {
    reports.push(safe_skip("variable-read-created", "variable_set_failed"))
    reports.push(safe_skip("variable-update", "variable_set_failed"))
    reports.push(safe_skip("variable-read-updated", "variable_set_failed"))
    reports.push(safe_skip("variable-list", "variable_set_failed"))
    reports.push(safe_skip("variable-delete", "variable_set_failed"))
    reports.push(safe_skip("variable-list-deleted", "variable_set_failed"))
  }

  // Actions reads are safe and establish the request/output boundary without
  // creating a workflow run.  Keep the output in memory only: step_record
  // records sizes and sanitized diagnostics, never response bodies.
  let workflow_list = run_command(binary, config, token, [
    "workflow", "list", "-R", allowed_repo, "--json", "id,name,state",
  ])
  let (workflow_entry, workflow_ok) = step_record(
    "actions-workflow-list", workflow_list, token,
  )
  reports.push(workflow_entry)
  all_passed = all_passed && workflow_ok
  let run_list = run_command(binary, config, token, [
    "run", "list", "-R", allowed_repo, "--json", "databaseId,status,conclusion,name",
  ])
  let (run_entry, run_ok) = step_record("actions-run-list", run_list, token)
  reports.push(run_entry)
  all_passed = all_passed && run_ok
  let cache_list = run_command(binary, config, token, [
    "cache", "list", "-R", allowed_repo, "--json", "id,key,ref,sizeInBytes",
  ])
  let (cache_entry, cache_ok) = step_record(
    "actions-cache-list", cache_list, token,
  )
  reports.push(cache_entry)
  all_passed = all_passed && cache_ok

  // Dispatch/cancel/rerun/watch and log/artifact retrieval need a marker
  // workflow file and run.  Do not guess an existing workflow ID or mutate a
  // run that this fixture did not create; make the deferred coverage explicit
  // in the report instead.
  for
    (name, reason) in [
      ("actions-workflow-dispatch", "marker_workflow_not_created"),
      ("actions-run-view", "marker_run_not_created"),
      ("actions-run-logs", "marker_run_not_created"),
      ("actions-run-artifacts", "marker_run_not_created"),
      ("actions-run-cancel", "marker_run_not_created"),
      ("actions-run-rerun", "marker_run_not_created"),
      ("actions-run-watch", "marker_run_not_created"),
      ("actions-run-exit-status", "marker_run_not_created"),
    ] {
    reports.push(safe_skip(name, reason))
  }

  // Creating an Actions cache requires a workflow run and can race with
  // eviction.  Never issue a broad `cache delete`; this explicit record keeps
  // the safety decision visible in the sanitized report.
  reports.push(
    safe_skip("cache-safe-skip", "cache_creation_requires_marker_workflow_run"),
  )

  let branch_name = marker + "-branch"
  let merge_base_name = marker + "-base"
  let ref_result = run_command(
    binary,
    config,
    token,
    api_path("/repos/" + allowed_repo + "/git/ref/heads/" + base),
  )
  let head_sha = match nested_string(ref_result.stdout, "object", "sha") {
    Some(value) => value
    None => ""
  }
  let (e, base_ok) = assertion_record(
    "branch-read-base",
    ref_result,
    token,
    !head_sha.is_empty(),
    "default_branch_sha_unavailable",
  )
  reports.push(e)
  all_passed = all_passed && base_ok
  if base_ok {
    let created_base = run_command(binary, config, token, [
      "api",
      "/repos/" + allowed_repo + "/git/refs",
      "--hostname",
      "github.com",
      "--method",
      "POST",
      "-f",
      "ref=refs/heads/" + merge_base_name,
      "-f",
      "sha=" + head_sha,
    ])
    let (e, ok) = step_record("branch-create-base", created_base, token)
    reports.push(e)
    all_passed = all_passed && ok
    if created_base.exit_code == 0 {
      merge_base_branch = Some(merge_base_name)
    }
    let created = run_command(binary, config, token, [
      "api",
      "/repos/" + allowed_repo + "/git/refs",
      "--hostname",
      "github.com",
      "--method",
      "POST",
      "-f",
      "ref=refs/heads/" + branch_name,
      "-f",
      "sha=" + head_sha,
    ])
    let (e, ok) = step_record("branch-create", created, token)
    reports.push(e)
    all_passed = all_passed && ok
    if created.exit_code == 0 {
      branch = Some(branch_name)
    }
  } else {
    reports.push({
      "name": Json("branch-create"),
      "exit_code": Json(1),
      "passed": Json(false),
      "diagnostic": Json("default_branch_sha_unavailable"),
    })
    all_passed = false
  }

  match (branch, merge_base_branch) {
    (Some(branch_name), Some(merge_base_name)) => {
      let content_path = marker + ".md"
      let content = run_command(binary, config, token, [
        "api",
        "/repos/" + allowed_repo + "/contents/" + content_path,
        "--hostname",
        "github.com",
        "--method",
        "PUT",
        "-f",
        "message=" + marker + " fixture",
        "-f",
        "content=" + base64_encode(marker + " fixture content\n"),
        "-f",
        "branch=" + branch_name,
      ])
      let (e, ok) = step_record("contents-create", content, token)
      reports.push(e)
      all_passed = all_passed && ok
      if content.exit_code == 0 {
        file_path = Some(content_path)
        file_sha = nested_string(content.stdout, "content", "sha")
        pr_head_sha = nested_string(content.stdout, "commit", "sha")
      }
      let pr = run_command(binary, config, token, [
        "pr",
        "create",
        "-R",
        allowed_repo,
        "--head",
        branch_name,
        "--base",
        merge_base_name,
        "--title",
        marker + " pull request",
        "--body",
        marker + " pull request body",
      ])
      let (e, ok) = step_record("pr-create", pr, token)
      reports.push(e)
      all_passed = all_passed && ok
      if pr.exit_code == 0 {
        pr_number = resource_number(pr)
      }
      match pr_number {
        Some(number) => {
          let view = run_command(binary, config, token, [
            "pr", "view", number, "-R", allowed_repo, "--json", "number,title,state",
          ])
          let (e, ok) = state_step(
            "pr-view",
            view,
            token,
            "open",
            marker + " pull request",
          )
          reports.push(e)
          all_passed = all_passed && ok
          let comment = run_command(binary, config, token, [
            "pr",
            "comment",
            number,
            "-R",
            allowed_repo,
            "--body",
            marker + " pull request comment",
          ])
          let (e, ok) = step_record("pr-comment", comment, token)
          reports.push(e)
          all_passed = all_passed && ok
          let review = run_command(binary, config, token, [
            "pr",
            "review",
            number,
            "-R",
            allowed_repo,
            "--comment",
            "--body",
            marker + " pull request review",
          ])
          let (e, ok) = assertion_record(
            "pr-review-comment",
            review,
            token,
            json_string(review.stdout, "state") == Some("COMMENTED") &&
            json_string(review.stdout, "body") ==
            Some(marker + " pull request review"),
            "review_state_or_body_mismatch",
          )
          reports.push(e)
          all_passed = all_passed && ok
          let edit = run_command(binary, config, token, [
            "pr",
            "edit",
            number,
            "-R",
            allowed_repo,
            "--title",
            marker + " pull request edited",
            "--body",
            marker + " pull request edited body",
          ])
          let (e, ok) = step_record("pr-edit", edit, token)
          reports.push(e)
          all_passed = all_passed && ok
          let edited = run_command(binary, config, token, [
            "pr", "view", number, "-R", allowed_repo, "--json", "number,title,state",
          ])
          let (e, ok) = state_step(
            "pr-view-edited",
            edited,
            token,
            "open",
            marker + " pull request edited",
          )
          reports.push(e)
          all_passed = all_passed && ok
          for
            (name, action, view_name, expected_state) in [
              ("pr-close", "close", "pr-view-closed", "closed"),
              ("pr-reopen", "reopen", "pr-view-reopened", "open"),
            ] {
            let command = run_command(binary, config, token, [
              "pr", action, number, "-R", allowed_repo,
            ])
            let (e, ok) = step_record(name, command, token)
            reports.push(e)
            all_passed = all_passed && ok
            let view = run_command(binary, config, token, [
              "pr", "view", number, "-R", allowed_repo, "--json", "number,title,state",
            ])
            let (e, ok) = state_step(
              view_name,
              view,
              token,
              expected_state,
              marker + " pull request edited",
            )
            reports.push(e)
            all_passed = all_passed && ok
          }
          match pr_head_sha {
            Some(expected_sha) => {
              let merged = run_command(binary, config, token, [
                "pr", "merge", number, "-R", allowed_repo, "--merge", "--match-head-commit",
                expected_sha,
              ])
              if merged.exit_code == 0 && json_true(merged.stdout, "merged") {
                pr_merged = true
              }
              let (e, ok) = assertion_record(
                "pr-merge",
                merged,
                token,
                json_true(merged.stdout, "merged") &&
                json_string(merged.stdout, "sha").map_or(false, sha => {
                  !sha.is_empty()
                }),
                "merge_result_not_confirmed",
              )
              reports.push(e)
              all_passed = all_passed && ok
              let merged_view = run_command(
                binary,
                config,
                token,
                api_path("/repos/" + allowed_repo + "/pulls/" + number),
              )
              if merged_view.exit_code == 0 &&
                json_true(merged_view.stdout, "merged") {
                pr_merged = true
              }
              let merge_sha = json_string(
                merged_view.stdout,
                "merge_commit_sha",
              )
              let (e, ok) = assertion_record(
                "pr-view-merged",
                merged_view,
                token,
                json_true(merged_view.stdout, "merged") &&
                json_string(merged_view.stdout, "state") == Some("closed") &&
                merge_sha.map_or(false, sha => !sha.is_empty()) &&
                nested_string(merged_view.stdout, "base", "ref") ==
                Some(merge_base_name) &&
                nested_string(merged_view.stdout, "head", "sha") ==
                Some(expected_sha),
                "merged_pull_request_state_mismatch",
              )
              reports.push(e)
              all_passed = all_passed && ok
              let merged_ref = run_command(
                binary,
                config,
                token,
                api_path(
                  "/repos/" + allowed_repo + "/git/ref/heads/" + merge_base_name,
                ),
              )
              let (e, ok) = assertion_record(
                "branch-view-merged",
                merged_ref,
                token,
                merge_sha is Some(_) &&
                nested_string(merged_ref.stdout, "object", "sha") == merge_sha,
                "merge_target_sha_mismatch",
              )
              reports.push(e)
              all_passed = all_passed && ok
              let merged_contents = run_command(binary, config, token, [
                "api",
                "/repos/" + allowed_repo + "/contents/" + content_path,
                "--hostname",
                "github.com",
                "--method",
                "GET",
                "-f",
                "ref=" + merge_base_name,
              ])
              let actual_content = json_string(
                merged_contents.stdout,
                "content",
              ).map(value => {
                value
                .replace_all(old="\n", new="")
                .replace_all(old="\r", new="")
              })
              let (e, ok) = assertion_record(
                "contents-view-merged",
                merged_contents,
                token,
                file_sha is Some(_) &&
                json_string(merged_contents.stdout, "sha") == file_sha &&
                actual_content ==
                Some(base64_encode(marker + " fixture content\n")),
                "merge_target_contents_mismatch",
              )
              reports.push(e)
              all_passed = all_passed && ok
            }
            None => {
              reports.push({
                "name": Json("pr-merge"),
                "exit_code": Json(1),
                "passed": Json(false),
                "diagnostic": Json("pull_request_head_sha_unavailable"),
              })
              all_passed = false
            }
          }
        }
        None => {
          reports.push({
            "name": Json("pr-view"),
            "exit_code": Json(1),
            "passed": Json(false),
            "diagnostic": Json("pull_request_number_unavailable"),
          })
          all_passed = false
        }
      }
    }
    _ => {
      reports.push(safe_skip("pr-create", "marker_branches_unavailable"))
      all_passed = false
    }
  }

  let tag = marker + "-release"
  let release = run_command(binary, config, token, [
    "release",
    "create",
    tag,
    "-R",
    allowed_repo,
    "--title",
    marker + " release",
    "--body",
    marker + " release body",
    "--target-commitish",
    base,
  ])
  let (e, ok) = step_record("release-create", release, token)
  reports.push(e)
  all_passed = all_passed && ok
  if release.exit_code == 0 {
    release_tag = Some(tag)
  }
  match release_tag {
    Some(tag) => {
      let view = run_command(binary, config, token, [
        "release", "view", tag, "-R", allowed_repo, "--json", "tagName,name",
      ])
      let (e, ok) = step_record("release-view", view, token)
      reports.push(e)
      all_passed = all_passed && ok
      let edit = run_command(binary, config, token, [
        "release",
        "edit",
        tag,
        "-R",
        allowed_repo,
        "--title",
        marker + " release edited",
        "--body",
        marker + " release edited body",
      ])
      let (e, ok) = step_record("release-edit", edit, token)
      reports.push(e)
      all_passed = all_passed && ok
      let asset_name = marker + ".asset"
      let asset_path = config + "/" + asset_name
      let asset_written = write_fixture_file(
        asset_path,
        marker + " asset\n",
        permission=0o600,
      )
      if !asset_written {
        reports.push({
          "name": Json("release-asset-fixture"),
          "exit_code": Json(1),
          "passed": Json(false),
          "diagnostic": Json("cannot_write_local_asset_fixture"),
        })
        all_passed = false
      }
      let upload = run_command(binary, config, token, [
        "release", "upload", tag, asset_path, "-R", allowed_repo, "--clobber",
      ])
      let (e, ok) = step_record("release-upload", upload, token)
      reports.push(e)
      all_passed = all_passed && ok
      let assets = run_command(binary, config, token, [
        "release", "view", tag, "-R", allowed_repo, "--json", "assets",
      ])
      let found_asset = release_asset_id(assets.stdout, asset_name)
      if assets.exit_code == 0 {
        asset_id = found_asset.unwrap_or(None)
      }
      let (e, ok) = assertion_record(
        "release-view-assets",
        assets,
        token,
        found_asset is Ok(Some(_)),
        "uploaded_asset_name_missing",
      )
      reports.push(e)
      all_passed = all_passed && ok
      let download_dir = config + "/downloads"
      let download = run_command(binary, config, token, [
        "release", "download", tag, "-R", allowed_repo, "--pattern", asset_name,
        "--dir", download_dir,
      ])
      let bytes_match = fixture_files_equal(
        asset_path,
        download_dir + "/" + asset_name,
      )
      let (e, ok) = assertion_record(
        "release-download", download, token, bytes_match, "downloaded_asset_bytes_mismatch",
      )
      reports.push(e)
      all_passed = all_passed && ok
      match asset_id {
        Some(_) => {
          let deleted = run_command(binary, config, token, [
            "release", "delete-asset", tag, asset_name, "-R", allowed_repo, "--yes",
          ])
          let (e, ok) = step_record("release-delete-asset", deleted, token)
          reports.push(e)
          all_passed = all_passed && ok
          let after_delete = run_command(binary, config, token, [
            "release", "view", tag, "-R", allowed_repo, "--json", "assets",
          ])
          let asset_absent = release_asset_id(after_delete.stdout, asset_name)
            is Ok(None)
          let (e, ok) = assertion_record(
            "release-view-asset-deleted", after_delete, token, asset_absent, "deleted_asset_still_present_or_metadata_invalid",
          )
          reports.push(e)
          all_passed = all_passed && ok
          if after_delete.exit_code == 0 && asset_absent {
            asset_id = None
          }
        }
        None => {
          reports.push({
            "name": Json("release-delete-asset"),
            "exit_code": Json(1),
            "passed": Json(false),
            "diagnostic": Json("asset_id_unavailable"),
          })
          all_passed = false
        }
      }
      let deleted = run_command(binary, config, token, [
        "release", "delete", tag, "-R", allowed_repo, "--yes",
      ])
      let (e, ok) = step_record("release-delete", deleted, token)
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code == 0 {
        release_deleted = true
        // Deleting a release also removes its assets. A prior failed asset
        // deletion is still a failed test, but no longer a residual resource.
        asset_id = None
      }
      let tag_deleted = run_command(binary, config, token, [
        "api",
        "/repos/" + allowed_repo + "/git/refs/tags/" + tag,
        "--hostname",
        "github.com",
        "--method",
        "DELETE",
      ])
      let (e, ok) = step_record("release-delete-tag", tag_deleted, token)
      reports.push(e)
      all_passed = all_passed && ok
      if tag_deleted.exit_code == 0 {
        release_tag_deleted = true
      }
      if release_deleted && release_tag_deleted {
        release_tag = None
      }
    }
    None => ()
  }

  // Cleanup is deliberately unconditional. The report contains only names,
  // status codes, and bounded diagnostics; response bodies are never saved.
  match secret_created {
    true => {
      let deleted = run_command(binary, config, token, [
        "secret", "delete", secret_name, "-R", allowed_repo, "--yes",
      ])
      let (e, ok) = step_record_sensitive(
        "cleanup-secret",
        deleted,
        token,
        marker + " secret value",
      )
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code != 0 {
        residual.push("secret:" + secret_name)
      } else {
        secret_created = false
      }
    }
    false => ()
  }
  match variable_created {
    true => {
      let deleted = run_command(binary, config, token, [
        "variable", "delete", variable_name, "-R", allowed_repo, "--yes",
      ])
      let (e, ok) = step_record_sensitive(
        "cleanup-variable", deleted, token, variable_value,
      )
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code != 0 {
        residual.push("variable:" + variable_name)
      } else {
        variable_created = false
      }
    }
    false => ()
  }
  match (file_path, file_sha) {
    (Some(path), Some(sha)) => {
      let cleanup_branches : Array[(String, String)] = []
      if branch is Some(value) {
        cleanup_branches.push(("cleanup-contents", value))
      }
      if pr_merged && merge_base_branch is Some(value) {
        cleanup_branches.push(("cleanup-merged-contents", value))
      }
      for (name, branch_name) in cleanup_branches {
        // Only branches created and owned by this run enter this list.
        if branch_name.has_prefix(marker + "-") && branch_name != base {
          let deleted = run_command(binary, config, token, [
            "api",
            "/repos/" + allowed_repo + "/contents/" + path,
            "--hostname",
            "github.com",
            "--method",
            "DELETE",
            "-f",
            "message=" + marker + " cleanup",
            "-f",
            "sha=" + sha,
            "-f",
            "branch=" + branch_name,
          ])
          let (e, ok) = step_record(name, deleted, token)
          reports.push(e)
          all_passed = all_passed && ok
          // Branch deletion below also removes these files. Record a file
          // residual only if its owning marker branch survives cleanup.
        }
      }
    }
    _ => ()
  }
  match asset_id {
    Some(id) => {
      let deleted = run_command(binary, config, token, [
        "api",
        "/repos/" + allowed_repo + "/releases/assets/" + id,
        "--hostname",
        "github.com",
        "--method",
        "DELETE",
      ])
      let (e, ok) = step_record("cleanup-asset", deleted, token)
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code == 0 {
        asset_id = None
      }
    }
    None => ()
  }
  match release_tag {
    Some(tag) => {
      // DELETE /releases/tags/{tag} is not a GitHub REST operation. Resolve
      // the tag metadata first, then delete by its numeric release id. If the
      // main lifecycle already deleted the release, retry only the git ref.
      if !release_deleted {
        let metadata = run_command(binary, config, token, [
          "api",
          "/repos/" + allowed_repo + "/releases/tags/" + tag,
          "--hostname",
          "github.com",
        ])
        let release_id = if metadata.exit_code == 0 {
          json_id(metadata.stdout)
        } else {
          None
        }
        let deleted = match release_id {
          Some(id) =>
            run_command(binary, config, token, [
              "api",
              "/repos/" + allowed_repo + "/releases/" + id,
              "--hostname",
              "github.com",
              "--method",
              "DELETE",
            ])
          None => metadata
        }
        let (e, ok) = assertion_record(
          "cleanup-release",
          deleted,
          token,
          release_id is Some(_),
          "release_id_unavailable",
        )
        reports.push(e)
        all_passed = all_passed && ok
        if deleted.exit_code == 0 && release_id is Some(_) {
          release_deleted = true
          asset_id = None
        } else {
          residual.push("release:" + tag)
        }
      }
      if !release_tag_deleted {
        let tag_deleted = run_command(binary, config, token, [
          "api",
          "/repos/" + allowed_repo + "/git/refs/tags/" + tag,
          "--hostname",
          "github.com",
          "--method",
          "DELETE",
        ])
        let (e, ok) = step_record("cleanup-release-tag", tag_deleted, token)
        reports.push(e)
        all_passed = all_passed && ok
        if tag_deleted.exit_code == 0 {
          release_tag_deleted = true
        } else {
          residual.push("tag:" + tag)
        }
      }
      if release_deleted && release_tag_deleted {
        release_tag = None
      }
    }
    None => ()
  }
  if asset_id is Some(id) {
    residual.push("asset:" + id)
  }
  match pr_number {
    Some(value) if !pr_merged => {
      // Merged and closed PRs remain as historical records. Only a failed
      // close is an active residual; GitHub has no PR delete operation.
      let closed = run_command(binary, config, token, [
        "pr", "close", value, "-R", allowed_repo,
      ])
      let (e, ok) = step_record("cleanup-pull-request", closed, token)
      reports.push(e)
      all_passed = all_passed && ok
      if closed.exit_code != 0 {
        residual.push("pull_request:" + value)
      }
    }
    _ => ()
  }
  match branch {
    Some(value) => {
      let deleted = run_command(binary, config, token, [
        "api",
        "/repos/" + allowed_repo + "/git/refs/heads/" + value,
        "--hostname",
        "github.com",
        "--method",
        "DELETE",
      ])
      let (e, ok) = step_record("cleanup-branch", deleted, token)
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code != 0 {
        residual.push("branch:" + value)
      } else {
        branch = None
      }
    }
    None => ()
  }
  match merge_base_branch {
    Some(value) => {
      let deleted = run_command(binary, config, token, [
        "api",
        "/repos/" + allowed_repo + "/git/refs/heads/" + value,
        "--hostname",
        "github.com",
        "--method",
        "DELETE",
      ])
      let (e, ok) = step_record("cleanup-merge-base-branch", deleted, token)
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code != 0 {
        residual.push("branch:" + value)
      } else {
        merge_base_branch = None
      }
    }
    None => ()
  }
  match issue_number {
    Some(value) => {
      let deleted = run_command(binary, config, token, [
        "api",
        "/repos/" + allowed_repo + "/issues/" + value,
        "--hostname",
        "github.com",
        "--method",
        "DELETE",
      ])
      let (e, ok) = step_record("cleanup-issue", deleted, token)
      reports.push(e)
      all_passed = all_passed && ok
      if deleted.exit_code != 0 {
        residual.push("issue:" + value)
      } else {
        issue_number = None
      }
    }
    None => ()
  }
  let final_default_ref = run_command(
    binary,
    config,
    token,
    api_path("/repos/" + allowed_repo + "/git/ref/heads/" + base),
  )
  let (e, ok) = assertion_record(
    "branch-default-unchanged",
    final_default_ref,
    token,
    base_ok &&
    nested_string(final_default_ref.stdout, "object", "sha") == Some(head_sha),
    "default_branch_sha_changed_or_baseline_unavailable",
  )
  reports.push(e)
  all_passed = all_passed && ok
  let cleanup_ok = residual.is_empty()
  let report : Json = {
    "schema": 3,
    "mode": "write-lifecycle",
    "repository": allowed_repo,
    "marker": marker,
    // This aggregate covers executed lifecycle cases only. Actions cases
    // explicitly skipped above and complete command parity remain unverified.
    "write_operations_verified": all_passed && cleanup_ok,
    "verification_scope": "executed_lifecycle_only",
    "permission_gated": [],
    "core_parity_verified": false,
    "cleanup_passed": cleanup_ok,
    "residual_resources": Json(residual),
    "cases": Json(reports),
  }
  let report_written = try {
    @fs.write_file(
      report_path,
      report.stringify(indent=2) + "\n",
      permission=0o600,
      create_mode=@fs.CreateNew,
    )
    true
  } catch {
    _ => false
  }
  guard report_written else { fail("cannot write sanitized live write report") }
  println("Report: " + report_path)
  if !all_passed || !cleanup_ok {
    fail("live write fixture failed; inspect sanitized report")
  }
}
