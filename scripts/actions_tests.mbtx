///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/json",
}

///|
async fn main {
  let data = @json.parse(
    @fs.read_file("testdata/actions-oracle-v2.102.0.json").text(),
  )
  guard data
    is {
      "oracle_sha256": String(
        "8a4258433c81106343144857750316241759d06dcf16265cf3c4864a8f2f2ad6"
      ),
      "failures": Number(0, ..),
      "expected_cases": Number(expected, ..),
      "completed_cases": Number(completed, ..),
      "cases": Array(cases),
      ..
    } &&
    completed == expected &&
    completed == cases.length().to_double() else {
    fail("incomplete oracle evidence")
  }
  let source = StringBuilder()
  source.write_string(
    "// Generated from the pinned oracle by scripts/actions_tests.mbtx.\n",
  )
  for case in cases {
    guard case is { "id": String(id), .. } else { fail("case ID missing") }
    source.write_string(
      "///|\nasync test " + Json("Actions oracle " + id).stringify() + " {\n",
    )
    source.write_string(
      "  check_actions_oracle(" + Json(case.stringify()).stringify() + ")\n}\n",
    )
  }
  @fs.write_file("native/actions_oracle_cases_test.mbt", source.to_string())
}
