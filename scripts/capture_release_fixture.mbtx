///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/x@0.5.5/crypto",
}

///|
/// Retain only the public proof already verified by the fixed oracle. This
/// script never reads credentials, makes network requests or trusts a proof
/// merely because it was captured; the generated test verifies it again.
async fn main {
  let args = @env.args()
  guard args.length() == 2 else {
    fail("usage: capture_release_fixture.mbtx PUBLIC_RELEASE_REPORT_DIRECTORY")
  }
  let report = @json.parse(@fs.read_file(args[1] + "/report.json").text())
  guard report
    is {
      "repository": String("cli/cli"),
      "tag": String("v2.102.0"),
      "oracle_sha256": String(
        "8a4258433c81106343144857750316241759d06dcf16265cf3c4864a8f2f2ad6"
      ),
      "remote_mutations": Number(0, ..),
      "cases": [{ "oracle_exit": Number(0, ..), .. }],
      ..
    } else {
    fail("fixed public oracle success required")
  }
  let output = @fs.read_file(args[1] + "/oracle.stdout").text()
  guard @json.parse(output) is { "attestation": { "bundle": bundle, .. }, .. } &&
    bundle is { "dsseEnvelope": { "payload": String(payload), .. }, .. } else {
    fail("public bundle missing")
  }
  guard @json.parse(@utf8.decode(@base64.decode(payload)))
    is {
      "predicateType": String("https://in-toto.io/attestation/release/v0.2"),
      "predicate": {
        "repository": String("cli/cli"),
        "tag": String("v2.102.0"),
        ..
      },
      ..
    } else {
    fail("unexpected public release identity")
  }
  let text = bundle.stringify(indent=2) + "\n"
  let hash = @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(text)))
  @fs.write_file("testdata/attestation/cli-v2.102.0-release-bundle.json", text)
  @fs.write_file(
    "testdata/attestation/cli-v2.102.0-release-provenance.json",
    Json::object({
      "repository": "cli/cli",
      "tag": "v2.102.0",
      "source": "https://api.github.com/repos/cli/cli/attestations/sha1:fc4b137cdef0a6bd28fd461b7cf9c84a5812a8cd?predicate_type=release",
      "bundle_sha256": hash,
      "oracle_sha256": "8a4258433c81106343144857750316241759d06dcf16265cf3c4864a8f2f2ad6",
      "trust": "untrusted fixture; independently verified in tests",
    }).stringify(indent=2) +
    "\n",
  )
  @fs.write_file(
    "internal/attestation/public_release_fixture_wbtest.mbt",
    "// Generated by scripts/capture_release_fixture.mbtx; public signed proof.\n///|\n" +
    "fn public_release_fixture() -> Bytes { @utf8.encode(" +
    Json(text).stringify() +
    ") }\n",
  )
}
